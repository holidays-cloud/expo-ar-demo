{
  "name": "expo-ar-demo",
  "private": true,
  "type": "module",
  "description": "Expo booth AR demo. No build step for the site; these devDependencies only feed tools/ scripts.",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "print": "node tools/make-print.mjs && python3 -I tools/import-scans.py",
    "targets": "node tools/compile-targets.mjs",
    "inspect": "node tools/inspect-target.mjs targets/banner.mind",
    "serve": "node tools/serve.mjs",
    "print:card": "node tools/make-print.mjs doc5 doc6"
  },
  "devDependencies": {
    "@fontsource/aref-ruqaa": "5.3.0",
    "mind-ar": "1.2.5",
    "qrcode": "^1.5.4",
    "three": "^0.160.0",
    "vazirmatn": "33.0.3"
  }
}
